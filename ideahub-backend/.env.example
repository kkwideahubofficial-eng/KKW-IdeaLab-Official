# Environment Variables for Render Deployment (ideahub-backend)

# Server Port (Render automatically sets PORT)
PORT=5000

# Node Environment
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas or hosted MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ideahub?retryWrites=true&w=majority

# JWT Secret for Auth Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Allowed Frontend Origins for CORS (e.g. https://your-app.vercel.app)
FRONTEND_ORIGIN=https://your-frontend.vercel.app

# Cloudinary Configuration for Image Uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration (Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
